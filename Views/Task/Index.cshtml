@model IEnumerable<GPMS.Models.Task>

<link rel="stylesheet" href="~/css/site.css" />

@{
    var taskPermissions = ViewBag.TaskPermissions as Dictionary<int, List<string>>;
    var selectedProjectId = ViewBag.SelectedProjectId?.ToString() ?? "";
    var selectedModuleId = ViewBag.SelectedModuleId?.ToString() ?? "";
    var searchText = ViewBag.Search?.ToString() ?? "";
    var selectedStatus = ViewBag.Status?.ToString() ?? "";
    var startDate = ViewBag.StartDate?.ToString() ?? "";
    var endDate = ViewBag.EndDate?.ToString() ?? "";
    bool isAdmin = ViewBag.IsAdmin == true;
}

<div class="page-container">

    <div class="page-header">
        <h2 class="page-title">TASKS</h2>
        <a asp-action="Create" class="btn">+ New Task</a>
    </div>

    <form method="get" asp-action="Index" id="filterForm">

        <div class="search-bar" style="display:flex; gap:10px; margin-bottom:10px;">

            <!-- ✅ PROJECT DROPDOWN (FIXED) -->
            <select id="projectId" name="projectId" class="form-control">
                <option value="">All Projects</option>
                @if (ViewBag.Projects != null)
                {
                    foreach (var p in ViewBag.Projects as List<SelectListItem>)
                    {
                        var selected = selectedProjectId == p.Value;

                        <option value="@p.Value" selected="@(selected ? "selected" : null)">
                            @p.Text
                        </option>
                    }
                }
            </select>

            <!-- ✅ MODULE DROPDOWN (FIXED SAME WAY) -->
            <select id="moduleId" name="moduleId" class="form-control">
                <option value="">All Modules</option>
                @if (ViewBag.Modules != null)
                {
                    foreach (var m in ViewBag.Modules as List<SelectListItem>)
                    {
                        var selected = selectedModuleId == m.Value;

                        <option value="@m.Value" selected="@(selected ? "selected" : null)">
                            @m.Text
                        </option>
                    }
                }
            </select>

            <input type="text" name="search" class="form-control"
                   placeholder="Search task..." value="@searchText" />

            <button type="submit" class="btn btn-primary-custom">Search</button>
        </div>

        <div class="search-bar" style="display:flex; gap:10px;">
            <input type="date" name="startDate" class="form-control" value="@startDate" />
            <input type="date" name="endDate" class="form-control" value="@endDate" />

            <select name="status" class="form-control">
                <option value="">All Status</option>
                <option value="Pending" selected="@(selectedStatus == "Pending" ? "selected" : null)">Pending</option>
                <option value="In Progress" selected="@(selectedStatus == "In Progress" ? "selected" : null)">In Progress</option>
                <option value="Completed" selected="@(selectedStatus == "Completed" ? "selected" : null)">Completed</option>
            </select>
        </div>
    </form>

    <div class="card">
        <table class="task-table">
            <thead>
                <tr>
                    <th>Task Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="no-data">No tasks found</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var perms = taskPermissions != null && taskPermissions.ContainsKey(item.TaskId)
                            ? taskPermissions[item.TaskId]
                            : new List<string>();

                        bool canView = isAdmin || perms.Contains("ViewTask");
                        bool canEdit = isAdmin || perms.Contains("EditTask");
                        bool canDelete = isAdmin || perms.Contains("DeleteTask");

                        <tr>
                            <td>@item.TaskName</td>
                            <td>@item.TaskDescription</td>
                            <td>@item.TaskStatus</td>
                            <td>@item.TaskStartDate</td>
                            <td>@item.TaskEndDate</td>

                            <td>
                                @if (canView)
                                {
                                    <a asp-action="Details" asp-route-id="@item.TaskId" class="btn">View</a>
                                }
                                @if (canEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.TaskId" class="btn">Edit</a>
                                }
                                @if (canDelete)
                                {
                                    <form asp-action="Delete" asp-route-id="@item.TaskId" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-delete">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>