@model GPMS.ViewModels.ComposeMessageViewModel

<div class="compose-container">

    <h2>New Message</h2>

    <form method="post">

        <div class="form-group">
            <label>To</label>

            <input type="text"
                   id="employeeSearch"
                   class="form-control"
                   placeholder="Search employee..." />

            <div id="searchResults"></div>

            <div id="selectedEmployees"></div>
        </div>

        <div class="form-group">
            <label>Message</label>

            <textarea asp-for="Body"
                      rows="10"
                      class="form-control"></textarea>
        </div>

        <button type="submit" class="send-btn">
            Send Message
        </button>

    </form>

</div>

<script>

    let selectedUsers = [];

    document
        .getElementById('employeeSearch')
        .addEventListener('keyup', function () {

            let term = this.value;

            if (term.length < 1)
                return;

            fetch('/Message/SearchEmployees?term=' + term)
                .then(res => res.json())
                .then(data => {

                    let html = '';

                    data.forEach(emp => {

                        html += `
                            <div class="search-item"
                                 onclick="selectEmployee(${emp.id}, '${emp.name}')">
                                ${emp.name}
                            </div>
                        `;
                    });

                    document.getElementById('searchResults').innerHTML = html;
                });
        });

    function selectEmployee(id, name)
    {
        if (selectedUsers.includes(id))
            return;

        selectedUsers.push(id);

        let container = document.getElementById('selectedEmployees');

        container.innerHTML += `
            <div class="selected-user">
                ${name}

                <input type="hidden"
                       name="ReceiverIds"
                       value="${id}" />
            </div>
        `;
    }

</script>