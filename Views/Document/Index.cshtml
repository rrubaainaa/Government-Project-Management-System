@model IEnumerable<GPMS.Models.Document>

<link rel="stylesheet" href="~/css/site.css" />

<style>
    :root {
        --primary: #14b8a6;
        --primary-dark: #0f766e;
        --primary-light: #ccfbf1;
    }

    .search-bar {
        margin-bottom: 15px;
    }

        .search-bar input {
            width: 100%;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 6px;
        }

            .search-bar input:focus {
                border-color: var(--primary);
                outline: none;
                box-shadow: 0 0 0 2px rgba(20, 184, 166, 0.2);
            }

    .doc-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 10px;
        overflow: hidden;
    }

        .doc-table thead {
            background-color: var(--primary);
            color: white;
        }

        .doc-table th {
            padding: 14px;
            text-align: left;
            font-weight: 500;
        }

        .doc-table td {
            padding: 14px;
        }

        .doc-table tbody tr {
            border-bottom: 1px solid #eee;
            transition: 0.2s;
        }

            .doc-table tbody tr:hover {
                background-color: var(--primary-light);
            }

    .btn {
        background-color: var(--primary);
        color: white;
        padding: 6px 12px;
        border-radius: 6px;
        text-decoration: none;
        border: none;
        transition: 0.2s;
        font-size: 14px;
    }

        .btn:hover {
            background-color: var(--primary-dark);
        }

    .btn-outline {
        background: transparent;
        border: 1px solid var(--primary);
        color: var(--primary);
    }

        .btn-outline:hover {
            background: var(--primary);
            color: white;
        }

    .btn-delete {
        background-color: #ef4444;
    }

        .btn-delete:hover {
            background-color: #dc2626;
        }

    .no-data {
        text-align: center;
        padding: 20px;
        color: #888;
    }

    .alert-success {
        background: #dcfce7;
        color: #166534;
        padding: 10px;
        border-radius: 6px;
        margin-bottom: 10px;
    }

    .alert-error {
        background: #fee2e2;
        color: #991b1b;
        padding: 10px;
        border-radius: 6px;
        margin-bottom: 10px;
    }

    .btn-outline-primary {
        background: white;
        border: 1.5px solid #3b82f6;
        color: #3b82f6;
        padding: 6px 14px;
        border-radius: 6px;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-outline-primary:hover {
            background: #3b82f6;
            color: white;
        }
</style>

<div class="page-container">

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success" id="alertBox">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-error" id="alertBox">
            @TempData["Error"]
        </div>
    }

    <!-- HEADER -->
    <div class="page-header">
        <h2 class="page-title">DOCUMENTS</h2>

        @if (ViewBag.CanUpload == true)
        {
            <a asp-action="Upload" class="btn btn-outline-primary">
                + Add Document
            </a>
        }
    </div>

    <!-- SEARCH -->
    <div class="search-bar">
        <input type="text" id="documentSearch" placeholder="Search document..." />
    </div>

    <!-- TABLE -->
    <table class="doc-table" id="documentTable">
        <thead>
            <tr>
                <th>Document Name</th>
                <th>Assignment ID</th>
                <th>Uploaded At</th>
                <th>Uploaded By</th>
                <th style="width:220px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="no-data">No documents found</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.DocumentName</td>
                        <td>@(item.AssignmentId?.ToString() ?? "-")</td>
                        <td>@item.UploadedAt.ToString("dd MMM yyyy hh:mm tt")</td>
                        <td>@(item.UploadedByEmployee?.EmployeeName ?? "-")</td>

                        <td>
                            <a asp-action="Download"
                                   asp-route-id="@item.DocumentId"
                                   class="btn btn-outline">
                                View
                            </a>

                            <a asp-action="Edit"
                                   asp-route-id="@item.DocumentId"
                                   class="btn btn-outline">
                                Edit
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@item.DocumentId"
                                  method="post"
                                  style="display:inline;"
                                  onsubmit="return confirm('Are you sure?');">

                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-delete">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

</div>

<!-- SEARCH SCRIPT -->
<script>
    document.getElementById("documentSearch").addEventListener("keyup", function () {
        let searchValue = this.value.toLowerCase();
        let rows = document.querySelectorAll("#documentTable tbody tr");

        rows.forEach(row => {
            let text = row.innerText.toLowerCase();
            row.style.display = text.includes(searchValue) ? "" : "none";
        });
    });

    // AUTO HIDE ALERT
    setTimeout(() => {
        let alertBox = document.getElementById("alertBox");
        if (alertBox) {
            alertBox.style.display = "none";
        }
    }, 3000);
</script>