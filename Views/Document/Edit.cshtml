@model GPMS.Models.Document

<link rel="stylesheet" href="~/css/site.css" />

<div class="page-container">
    <div class="form-card">
        <h2 class="page-title">Edit Document</h2>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="DocumentId" />

            <div class="form-group">
                <label>Document Name</label>
                <input asp-for="DocumentName" class="form-control" />
                <span asp-validation-for="DocumentName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Assignment ID</label>
                <input asp-for="AssignmentId" class="form-control" />
                <span asp-validation-for="AssignmentId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Update</button>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </form>
    </div>
</div>
