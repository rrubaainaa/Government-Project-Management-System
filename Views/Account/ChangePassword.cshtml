@model GPMS.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}


<script src="~/js/crypto-js.min.js"></script>

<div class="page-container">

    <div class="form-card">

        <h2 class="page-title">
            Change Password
        </h2>

        <p class="text-muted">
            You must change your password on first login and every 4 months.
        </p>

        <form asp-action="ChangePassword"
              method="post"
              id="changePasswordForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <!-- CURRENT PASSWORD -->
            <div class="form-group">

                <label asp-for="CurrentPassword"></label>

                <!-- VISIBLE -->
                <input type="password"
                       id="CurrentPasswordVisible"
                       class="form-control" />

                <!-- HASHED -->
                <input asp-for="CurrentPassword"
                       type="hidden"
                       id="CurrentPassword" />

                <span asp-validation-for="CurrentPassword"
                      class="text-danger"></span>

            </div>

            <!-- NEW PASSWORD -->
            <div class="form-group">

                <label asp-for="NewPassword"></label>

                <!-- VISIBLE -->
                <input type="password"
                       id="NewPasswordVisible"
                       class="form-control" />

                <!-- HASHED -->
                <input asp-for="NewPassword"
                       type="hidden"
                       id="NewPassword" />

                <span asp-validation-for="NewPassword"
                      class="text-danger"></span>

            </div>

            <!-- CONFIRM PASSWORD -->
            <div class="form-group">

                <label asp-for="ConfirmPassword"></label>

                <!-- VISIBLE -->
                <input type="password"
                       id="ConfirmPasswordVisible"
                       class="form-control" />

                <!-- HASHED -->
                <input asp-for="ConfirmPassword"
                       type="hidden"
                       id="ConfirmPassword" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger"></span>

            </div>

            <button type="submit"
                    class="btn-save">

                Update Password

            </button>

        </form>

    </div>

</div>

<script>

    document.getElementById("changePasswordForm")
    .addEventListener("submit", function (e) {

    e.preventDefault();

    // =====================================
    // GET VALUES
    // =====================================
    var username =
    "@User.Identity.Name";

    var currentPassword =
    document.getElementById(
    "CurrentPasswordVisible"
    ).value;

    var newPassword =
    document.getElementById(
    "NewPasswordVisible"
    ).value;

    var confirmPassword =
    document.getElementById(
    "ConfirmPasswordVisible"
    ).value;

    // =====================================
    // VALIDATE PASSWORDS
    // =====================================
    if (newPassword !== confirmPassword)
    {
    alert("Passwords do not match.");
    return;
    }

    // =====================================
    // STATIC SALT
    // =====================================
    const salt = "GPMS_SALT";

    // =====================================
    // HASH CURRENT PASSWORD
    // username + currentPassword + salt
    // =====================================
    var currentHash =
    CryptoJS.SHA256(
    username +
    currentPassword +
    salt
    ).toString();

    // =====================================
    // HASH NEW PASSWORD
    // username + newPassword + salt
    // =====================================
    var newHash =
    CryptoJS.SHA256(
    username +
    newPassword +
    salt
    ).toString();

    // =====================================
    // SET HASHED VALUES
    // =====================================
    document.getElementById(
    "CurrentPassword"
    ).value = currentHash;

    document.getElementById(
    "NewPassword"
    ).value = newHash;

    document.getElementById(
    "ConfirmPassword"
    ).value = newHash;

    // =====================================
    // CLEAR VISIBLE PASSWORDS
    // =====================================
    document.getElementById(
    "CurrentPasswordVisible"
    ).value = "";

    document.getElementById(
    "NewPasswordVisible"
    ).value = "";

    document.getElementById(
    "ConfirmPasswordVisible"
    ).value = "";

    // =====================================
    // SUBMIT FORM
    // =====================================
    e.target.submit();

    });

</script>