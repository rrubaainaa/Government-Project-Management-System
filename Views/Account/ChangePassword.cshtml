@model GPMS.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<!-- ✅ ADD THIS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>

<div class="page-container">
    <div class="form-card">
        <h2 class="page-title">Change Password</h2>

        <p class="text-muted">
            You must change your password on first login and every 4 months.
        </p>

        <!-- ✅ ADD ID -->
        <form asp-action="ChangePassword"
              method="post"
              id="changePasswordForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <!-- CURRENT PASSWORD -->
            <div class="form-group">
                <label asp-for="CurrentPassword"></label>

                <!-- ✅ VISIBLE -->
                <input type="password"
                       id="CurrentPasswordVisible"
                       class="form-control" />

                <!-- ✅ HASHED SENT -->
                <input asp-for="CurrentPassword"
                       type="hidden"
                       id="CurrentPassword" />

                <span asp-validation-for="CurrentPassword"
                      class="text-danger"></span>
            </div>

            <!-- NEW PASSWORD -->
            <div class="form-group">
                <label asp-for="NewPassword"></label>

                <!-- ✅ VISIBLE -->
                <input type="password"
                       id="NewPasswordVisible"
                       class="form-control" />

                <!-- ✅ HASHED SENT -->
                <input asp-for="NewPassword"
                       type="hidden"
                       id="NewPassword" />

                <span asp-validation-for="NewPassword"
                      class="text-danger"></span>
            </div>

            <!-- CONFIRM PASSWORD -->
            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>

                <!-- ✅ VISIBLE -->
                <input type="password"
                       id="ConfirmPasswordVisible"
                       class="form-control" />

                <!-- ✅ HASHED SENT -->
                <input asp-for="ConfirmPassword"
                       type="hidden"
                       id="ConfirmPassword" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn-save">
                Update Password
            </button>
        </form>
    </div>
</div>

<!-- ✅ ADD SCRIPT -->
<script>
    document.getElementById("changePasswordForm")
    .addEventListener("submit", function (e) {

    var currentPassword =
    document.getElementById("CurrentPasswordVisible").value;

    var newPassword =
    document.getElementById("NewPasswordVisible").value;

    var confirmPassword =
    document.getElementById("ConfirmPasswordVisible").value;

    // CHECK BEFORE HASHING
    if (newPassword !== confirmPassword) {
    e.preventDefault();
    alert("Passwords do not match.");
    return;
    }

    // SHA256 HASHES
    var hashedCurrent =
    CryptoJS.SHA256(currentPassword).toString();

    var hashedNew =
    CryptoJS.SHA256(newPassword).toString();

    var hashedConfirm =
    CryptoJS.SHA256(confirmPassword).toString();

    // SEND HASHED VALUES
    document.getElementById("CurrentPassword").value =
    hashedCurrent;

    document.getElementById("NewPassword").value =
    hashedNew;

    document.getElementById("ConfirmPassword").value =
    hashedConfirm;

    // CLEAR VISIBLE FIELDS
    document.getElementById("CurrentPasswordVisible").value = "";
    document.getElementById("NewPasswordVisible").value = "";
    document.getElementById("ConfirmPasswordVisible").value = "";
    });
</script>
