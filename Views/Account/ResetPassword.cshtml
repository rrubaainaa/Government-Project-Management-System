@model GPMS.Models.ResetPasswordViewModel

<link rel="stylesheet" href="~/css/site.css" />

<!-- CRYPTO JS -->
<script src="~/js/crypto-js.min.js"></script>

<div class="page-container">

    <div class="form-card">

        <h2 class="page-title">
            Reset Password
        </h2>

        <form asp-action="ResetPassword"
              method="post"
              id="resetPasswordForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger"></div>

            <!-- TOKEN -->
            <input type="hidden"
                   asp-for="Token" />

            <!-- EMAIL -->
            <input type="hidden"
                   asp-for="Email"
                   id="Email" />
            <input type="hidden"
                   id="Username"
                   value="@ViewBag.Username" />

            <!-- NEW PASSWORD -->
            <div class="form-group">

                <label asp-for="NewPassword"></label>

                <!-- VISIBLE -->
                <input type="password"
                       id="NewPasswordVisible"
                       class="form-control" />

                <!-- HASHED -->
                <input asp-for="NewPassword"
                       type="hidden"
                       id="NewPassword" />

                <span asp-validation-for="NewPassword"
                      class="text-danger"></span>

            </div>

            <!-- CONFIRM PASSWORD -->
            <div class="form-group">

                <label asp-for="ConfirmPassword"></label>

                <!-- VISIBLE -->
                <input type="password"
                       id="ConfirmPasswordVisible"
                       class="form-control" />

                <!-- HASHED -->
                <input asp-for="ConfirmPassword"
                       type="hidden"
                       id="ConfirmPassword" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger"></span>

            </div>

            <button type="submit"
                    class="btn">

                Reset Password

            </button>

        </form>

    </div>

</div>

<script>

    document.getElementById("resetPasswordForm")
    .addEventListener("submit", function (e) {

    e.preventDefault();

    // =====================================
    // GET VALUES
    // =====================================
    var username =
    document.getElementById("Username").value;

    var newPassword =
    document.getElementById(
    "NewPasswordVisible"
    ).value;

    var confirmPassword =
    document.getElementById(
    "ConfirmPasswordVisible"
    ).value;

    // =====================================
    // VALIDATE PASSWORDS
    // =====================================
    if (newPassword !== confirmPassword)
    {
    alert("Passwords do not match.");
    return;
    }

    // =====================================
    // STATIC SALT
    // =====================================
    const salt = "GPMS_SALT";

    // =====================================
    // CREATE BASE HASH
    // username + password + salt
    // =====================================
    var baseHash =
    CryptoJS.SHA256(
    username +
    newPassword +
    salt
    ).toString();

    // =====================================
    // SET HASHED VALUES
    // =====================================
    document.getElementById(
    "NewPassword"
    ).value = baseHash;

    document.getElementById(
    "ConfirmPassword"
    ).value = baseHash;

    // =====================================
    // CLEAR VISIBLE PASSWORDS
    // =====================================
    document.getElementById(
    "NewPasswordVisible"
    ).value = "";

    document.getElementById(
    "ConfirmPasswordVisible"
    ).value = "";

    // =====================================
    // SUBMIT FORM
    // =====================================
    e.target.submit();

    });

</script>