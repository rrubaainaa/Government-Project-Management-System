@model GPMS.Models.ResetPasswordViewModel

<link rel="stylesheet" href="~/css/site.css" />

<!-- ✅ ADD THIS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>

<div class="page-container">
    <div class="form-card">
        <h2 class="page-title">Reset Password</h2>

        <!-- ✅ ADD ID -->
        <form asp-action="ResetPassword"
              method="post"
              id="resetPasswordForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger"></div>

            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div class="form-group">
                <label asp-for="NewPassword"></label>

                <!-- ✅ VISIBLE PASSWORD -->
                <input type="password"
                       id="NewPasswordVisible"
                       class="form-control" />

                <!-- ✅ HASHED PASSWORD SENT -->
                <input asp-for="NewPassword"
                       type="hidden"
                       id="NewPassword" />

                <span asp-validation-for="NewPassword"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>

                <!-- ✅ VISIBLE CONFIRM PASSWORD -->
                <input type="password"
                       id="ConfirmPasswordVisible"
                       class="form-control" />

                <!-- ✅ HASHED CONFIRM PASSWORD -->
                <input asp-for="ConfirmPassword"
                       type="hidden"
                       id="ConfirmPassword" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn">
                Reset Password
            </button>
        </form>
    </div>
</div>

<!-- ✅ ADD SCRIPT -->
<script>
    document.getElementById("resetPasswordForm")
    .addEventListener("submit", function (e) {

    var newPassword =
    document.getElementById("NewPasswordVisible").value;

    var confirmPassword =
    document.getElementById("ConfirmPasswordVisible").value;

    // CHECK BEFORE HASHING
    if (newPassword !== confirmPassword) {
    e.preventDefault();
    alert("Passwords do not match.");
    return;
    }

    // SHA256 HASH
    var hashedNewPassword =
    CryptoJS.SHA256(newPassword).toString();

    var hashedConfirmPassword =
    CryptoJS.SHA256(confirmPassword).toString();

    // SEND HASHED VALUES
    document.getElementById("NewPassword").value =
    hashedNewPassword;

    document.getElementById("ConfirmPassword").value =
    hashedConfirmPassword;

    // CLEAR VISIBLE FIELDS
    document.getElementById("NewPasswordVisible").value = "";
    document.getElementById("ConfirmPasswordVisible").value = "";
    });
</script>